    {
      "id": "FULL_WELCOME_SCREEN",
      "title": "AMB Reminder",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "You are on the HDFC Bank WhatsApp Chat. We need to share some urgent and important information about AMB maintenance in your Savings Account.\n\nYour balance maintenance in your Savings Account is currently low.\n\nTo help you continue enjoying all account benefits and avoid AMB non-maintenance charges in future, we would want you to fund your account appropriately. Please let us know how you would like to proceed."
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": { "name": "data_exchange", "payload": {} }
          }
        ]
      }
    },
    {
      "id": "FULL_AMB_MENU_SCREEN",
      "title": "What would you like to do?",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "amb_menu_option",
            "list-items": [
              {
                "id": "fund_now",
                "main-content": {
                  "title": "I will fund my account now",
                  "description": "Get a top-up link"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "amb_menu_option": "fund_now" }
                }
              },
              {
                "id": "funds_shortly",
                "main-content": {
                  "title": "I expect funds shortly",
                  "description": "Funds arriving soon"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "amb_menu_option": "funds_shortly" }
                }
              },
